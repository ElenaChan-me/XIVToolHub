<!-- 黒・赤。Triggevent JP・Glamaholic JP と同じ色を使う -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBackground" Color="#121212" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#1B1B1B" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#262626" />
    <SolidColorBrush x:Key="BorderBrush" Color="#363636" />
    <SolidColorBrush x:Key="TextBrush" Color="#EDEDED" />
    <SolidColorBrush x:Key="SubTextBrush" Color="#A3A3A3" />
    <SolidColorBrush x:Key="AccentBrush" Color="#E23B44" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#F0555D" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="LinkBrush" Color="#FF6B72" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#3A1C1F" />
    <SolidColorBrush x:Key="UpdateBrush" Color="#F2B84B" />
    <SolidColorBrush x:Key="UpdateBackground" Color="#3A2C12" />
    <SolidColorBrush x:Key="InstalledBrush" Color="#6CCB7F" />
    <SolidColorBrush x:Key="ErrorText" Color="#FF7A7A" />
</ResourceDictionary>
