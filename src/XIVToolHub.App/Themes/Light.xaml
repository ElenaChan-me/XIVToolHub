<!-- 白・水色。Triggevent Plus・Glamaholic Plus と同じ色を使う -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBackground" Color="#F5FAFD" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#E6F4FB" />
    <SolidColorBrush x:Key="BorderBrush" Color="#CBE2EF" />
    <SolidColorBrush x:Key="TextBrush" Color="#1D2B36" />
    <SolidColorBrush x:Key="SubTextBrush" Color="#5B6B77" />
    <SolidColorBrush x:Key="AccentBrush" Color="#2EA7E0" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#4DB8EA" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="LinkBrush" Color="#1679A8" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#D4EEFA" />
    <SolidColorBrush x:Key="UpdateBrush" Color="#7A4E00" />
    <SolidColorBrush x:Key="UpdateBackground" Color="#FFF3D6" />
    <SolidColorBrush x:Key="InstalledBrush" Color="#2E7D3E" />
    <SolidColorBrush x:Key="ErrorText" Color="#C0392B" />
</ResourceDictionary>
