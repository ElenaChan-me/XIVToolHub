<Window x:Class="XIVToolHub.App.Views.ToolSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:XIVToolHub.App.ViewModels"
        Title="{Binding Title}"
        Width="760" Height="680" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource WindowStyle}">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="表示言語" Style="{StaticResource FieldLabel}" />
            <ComboBox ItemsSource="{Binding Languages}" DisplayMemberPath="DisplayName" SelectedValuePath="Code"
                      SelectedValue="{Binding SelectedLanguage}" Width="240" HorizontalAlignment="Left"
                      AutomationProperties.Name="表示言語" />
            <TextBlock Text="フォント" Style="{StaticResource FieldLabel}" Margin="0,16,0,4"
                       Visibility="{Binding SupportsFont, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,6"
                       Visibility="{Binding SupportsFont, Converter={StaticResource BoolToVisibility}}">
                追加フォントは日本語表示のときに使えます。フォントは同梱していないため、公式の配布元からダウンロードするか、
                入手したファイル（.ttf / .otf / .ttc または ZIP）を取り込んでください。フォントに無い文字は標準フォントで表示します。
            </TextBlock>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom">
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,10,0,0" />
            <TextBlock Style="{StaticResource HintText}" Margin="0,6,0,0" Text="変更はツールの次回起動時に反映されます。" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="保存" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="OnSaveClick" />
                <Button Content="キャンセル" IsCancel="True" Margin="0" />
            </StackPanel>
        </StackPanel>

        <ListBox ItemsSource="{Binding Fonts}" SelectedItem="{Binding SelectedFont}"
                 IsEnabled="{Binding IsFontEnabled}" HorizontalContentAlignment="Stretch"
                 BorderBrush="{DynamicResource BorderBrush}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 Visibility="{Binding SupportsFont, Converter={StaticResource BoolToVisibility}}"
                 AutomationProperties.Name="フォント一覧">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:FontItemViewModel}">
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="4,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding StatusText}" Margin="10,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource HintText}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource InstalledBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource HintText}" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding Warning}" Foreground="{DynamicResource ErrorText}" TextWrapping="Wrap" Margin="0,2,0,0"
                                           Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="10,0,0,0"
                                        Visibility="{Binding HasOfficialPage, Converter={StaticResource BoolToVisibility}}">
                                <Button Content="ダウンロード"
                                        Visibility="{Binding CanDownload, Converter={StaticResource BoolToVisibility}}"
                                        Command="{Binding DataContext.DownloadCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                                <Button Content="取り込み" Style="{StaticResource LinkButton}"
                                        Command="{Binding DataContext.ImportCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                                <Button Content="公式ページ" Style="{StaticResource LinkButton}"
                                        Command="{Binding DataContext.OpenPageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
