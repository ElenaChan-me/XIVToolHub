<Window x:Class="XIVToolHub.App.Views.TokenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GitHub トークン"
        Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource WindowStyle}">
    <StackPanel Margin="20">
        <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,12">
            同梱のツールは公開リポジトリから取得するので、トークンは無くても使えます。
            短い時間に何度も更新を確認して GitHub の利用制限（1時間に60回）に当たる場合や、Private リポジトリのツールを追加した場合に登録してください。
            GitHub の設定で「Fine-grained personal access token」を作成し、対象リポジトリの Contents を読み取り専用（Read-only）で許可します。
            トークンは Windows の資格情報マネージャーに保存され、ファイルには残りません。
        </TextBlock>
        <TextBlock x:Name="StatusText" Margin="0,0,0,8" />
        <PasswordBox x:Name="TokenBox" Padding="4,3" AutomationProperties.Name="GitHub トークン" />
        <TextBlock x:Name="MessageText" Foreground="{DynamicResource ErrorText}" TextWrapping="Wrap" Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="保存" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="OnSaveClick" />
            <Button Content="削除" Click="OnClearClick" />
            <Button Content="閉じる" IsCancel="True" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
