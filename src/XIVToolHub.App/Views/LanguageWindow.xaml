<Window x:Class="XIVToolHub.App.Views.LanguageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="表示言語の選択"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource WindowStyle}">
    <StackPanel Margin="20">
        <TextBlock Text="次のツールの表示言語を選んでください。" TextWrapping="Wrap" />
        <TextBlock x:Name="ToolsText" Style="{StaticResource HintText}" Margin="0,6,0,12" />
        <ComboBox x:Name="LanguageBox" DisplayMemberPath="DisplayName" SelectedValuePath="Code"
                  Width="240" HorizontalAlignment="Left" AutomationProperties.Name="表示言語" />
        <TextBlock Style="{StaticResource HintText}" Margin="0,12,0,0"
                   Text="あとから各ツールの「表示設定」で変更できます。日本語の場合は、そこでフォントも選べます。" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="インストール" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="OnOkClick" />
            <Button Content="キャンセル" IsCancel="True" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
