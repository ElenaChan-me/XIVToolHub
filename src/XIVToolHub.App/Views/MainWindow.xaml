<Window x:Class="XIVToolHub.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:XIVToolHub.App.ViewModels"
        Title="XIVToolHub - FF14 外部ツール管理"
        Width="1040" Height="760" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource WindowStyle}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,8">
            <WrapPanel>
                <Button Content="選択したツールをインストール・更新" Command="{Binding InstallSelectedCommand}" Style="{StaticResource PrimaryButton}" />
                <Button Content="選択したツールをアンインストール" Command="{Binding UninstallSelectedCommand}" />
                <Button Content="最新版を確認" Command="{Binding RefreshCommand}" />
                <Border Width="1" Margin="6,4,12,4" Background="{StaticResource BorderBrush}" />
                <Button Content="すべて選択" Command="{Binding SelectAllCommand}" />
                <Button Content="選択を解除" Command="{Binding ClearSelectionCommand}" />
                <Border Width="1" Margin="6,4,12,4" Background="{StaticResource BorderBrush}" />
                <Button Content="ツールを追加" Command="{Binding AddToolCommand}" />
                <Button Content="GitHub トークン" Command="{Binding TokenSettingsCommand}" />
            </WrapPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,5">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="処理中..." Foreground="{StaticResource SubTextBrush}"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Foreground="{StaticResource SubTextBrush}" TextTrimming="CharacterEllipsis">
                    <Run Text="保存先:" /> <Run Text="{Binding DataDirectory, Mode=OneWay}" />
                </TextBlock>
            </DockPanel>
        </Border>

        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="8" />
                <RowDefinition Height="150" MinHeight="80" />
            </Grid.RowDefinitions>

            <ListBox ItemsSource="{Binding Tools}" SelectedItem="{Binding SelectedItem}"
                     HorizontalContentAlignment="Stretch" BorderBrush="{StaticResource BorderBrush}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="ツール一覧">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ToolItemViewModel}">
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="6,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Top" Margin="0,3,10,0"
                                          AutomationProperties.Name="{Binding Name}" />
                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                                        <Border Background="#EEEEEB" CornerRadius="3" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding KindLabel}" FontSize="11" Foreground="{StaticResource SubTextBrush}" />
                                        </Border>
                                        <Border CornerRadius="3" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#EEEEEB" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding State}" Value="UpdateAvailable">
                                                            <Setter Property="Background" Value="{StaticResource UpdateBackground}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StateLabel}" FontSize="11">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource SubTextBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding State}" Value="UpdateAvailable">
                                                                <Setter Property="Foreground" Value="{StaticResource UpdateBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="Installed">
                                                                <Setter Property="Foreground" Value="{StaticResource InstalledBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding Notes}" Style="{StaticResource HintText}" Margin="0,2,0,0" />
                                    <TextBlock Style="{StaticResource HintText}" Margin="0,2,0,0"
                                               Visibility="{Binding HasDependencies, Converter={StaticResource BoolToVisibility}}">
                                        <Run Text="必要なツール:" /> <Run Text="{Binding DependsOnText, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding PreferencesText}" Style="{StaticResource HintText}" Margin="0,2,0,0"
                                               Visibility="{Binding CanConfigure, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,0">
                                        <Run Text="インストール済み:" /> <Run Text="{Binding InstalledVersionText, Mode=OneWay}" />
                                        <Run Text="   最新:" /> <Run Text="{Binding LatestVersionText, Mode=OneWay}" />
                                        <Run Text="   取得元:" /> <Run Text="{Binding SourceLabel, Mode=OneWay}" />
                                    </TextBlock>
                                    <StackPanel Margin="0,6,0,0" Visibility="{Binding IsWorking, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{Binding ProgressText}" Style="{StaticResource HintText}" />
                                        <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="1" Height="6" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Error}" Foreground="{StaticResource ErrorText}" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                                    <Button Content="起動" Visibility="{Binding IsApplication, Converter={StaticResource BoolToVisibility}}"
                                            Command="{Binding DataContext.LaunchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="表示設定" Visibility="{Binding CanConfigure, Converter={StaticResource BoolToVisibility}}"
                                            Command="{Binding DataContext.ToolSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="フォルダ" Style="{StaticResource LinkButton}"
                                            Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="GitHub" Style="{StaticResource LinkButton}"
                                            Command="{Binding DataContext.OpenRepositoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="カタログから削除" Style="{StaticResource LinkButton}"
                                            Command="{Binding DataContext.RemoveToolCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <Button.Visibility>
                                            <Binding Path="IsBuiltIn">
                                                <Binding.Converter>
                                                    <vm:InverseBoolToVisibilityConverter />
                                                </Binding.Converter>
                                            </Binding>
                                        </Button.Visibility>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" Background="Transparent" />

            <DockPanel Grid.Row="2">
                <TextBlock DockPanel.Dock="Top" Text="ログ" FontWeight="SemiBold" Margin="0,0,0,4" />
                <ListBox ItemsSource="{Binding Log}" BorderBrush="{StaticResource BorderBrush}" FontSize="12"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="ログ">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
